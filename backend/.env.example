# SmartFit Configuration

# Database
DATABASE_URL=sqlite:///./smartfit.db

# JWT Secret (change in production!)
SECRET_KEY=your-super-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI API Key for AI image analysis (optional, mock data used if not set)
OPENAI_API_KEY=

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
